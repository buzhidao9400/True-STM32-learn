{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "OpenOCD: flash",
            "type": "shell",
            "command": "openocd",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "args": [
                "-f",
                "openocd.cfg",
                "-c",
                "program build/Debug/liushuideng.elf verify reset exit"
            ],
            "dependsOn": "CMake: build",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
