{
    "cmake.sourceDirectory": "${workspaceFolder}/GPIO1",
    "cmake.configureOnOpen": false,
    "files.associations": {
        "*.h": "c"
    },
    "editor.formatOnSave": true,
    "[c]": {
        "editor.formatOnSave": false
    },
    "cortex-debug.variableUseNaturalFormat": true,
    "cmake.options.advanced": {
        "configurePreset": {
            "statusBarVisibility": "visible"
        },
        "build": {
            "statusBarVisibility": "hidden"
        },
        "launch": {
            "statusBarVisibility": "hidden"
        },
        "debug": {
            "statusBarVisibility": "hidden"
        }
    },
    "C_Cpp.default.compilerPath": "C:/Users/19480/scoop/apps/gcc-arm-none-eabi/current/bin/arm-none-eabi-gcc.exe",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/GPIO1/Core/Inc/**",
        "${workspaceFolder}/GPIO1/Drivers/**"
    ]
}
